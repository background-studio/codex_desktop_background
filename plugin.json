{
  "schemaVersion": 1,
  "pluginProtocol": 2,
  "id": "codex",
  "displayName": "Codex Background Studio",
  "exeName": "Codex Background Studio.exe",
  "pipeName": "\\\\.\\pipe\\background-studio-codex",
  "capabilities": {
    "mediaKinds": ["image", "video"],
    "injection": "cdp-blob",
    "hotUpdate": true,
    "autoTakeover": true,
    "loopbackMediaOnly": true,
    "keepsTargetOnShutdown": true,
    "maxMediaBytes": 67108864,
    "commands": [
      "hello",
      "configure",
      "status",
      "apply",
      "pause",
      "restore",
      "shutdown"
    ]
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit": {
        "type": "string",
        "enum": ["cover", "contain", "fill", "tile"],
        "default": "cover",
        "title": "适应方式"
      },
      "positionX": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "title": "水平焦点"
      },
      "positionY": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "title": "垂直焦点"
      },
      "opacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.72,
        "title": "背景不透明度"
      },
      "blur": {
        "type": "number",
        "minimum": 0,
        "maximum": 40,
        "default": 0,
        "title": "模糊"
      },
      "scale": {
        "type": "number",
        "minimum": 1,
        "maximum": 1.3,
        "default": 1,
        "title": "缩放"
      },
      "overlayColor": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "default": "#101416",
        "title": "遮罩颜色"
      },
      "overlayOpacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.9,
        "default": 0.12,
        "title": "遮罩不透明度"
      },
      "homeIntensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 1,
        "title": "首页强度"
      },
      "taskIntensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.32,
        "title": "任务页强度"
      },
      "sidebarOpacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.78,
        "title": "侧栏不透明度"
      },
      "surfaceOpacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.82,
        "title": "内容区不透明度"
      },
      "composerOpacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.88,
        "title": "输入区不透明度"
      },
      "menuOpacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.9,
        "title": "菜单不透明度"
      },
      "terminalOpacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.9,
        "title": "终端不透明度"
      },
      "enabledOnHome": {
        "type": "boolean",
        "default": true,
        "title": "首页显示背景"
      },
      "enabledOnTasks": {
        "type": "boolean",
        "default": true,
        "title": "任务页显示背景"
      },
      "videoMuted": {
        "type": "boolean",
        "default": true,
        "title": "视频静音"
      },
      "videoPlaybackRate": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 2,
        "default": 1,
        "title": "视频倍速"
      }
    }
  }
}
